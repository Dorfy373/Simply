:root {
}

.button {
    width: 100%;
    height: 30%;
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    font-size: 680%;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/CinzelDecorative-Bold.ttf?fileID=12800000&guid=2d6b41b3ee63e4d45985cca10623275f&type=3#CinzelDecorative-Bold");
    transition-duration: 0.3s;
}

.button:hover {
    width: 100%;
    height: 30%;
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    color: rgb(180, 180, 180);
    font-size: 680%;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/CinzelDecorative-Bold.ttf?fileID=12800000&guid=2d6b41b3ee63e4d45985cca10623275f&type=3#CinzelDecorative-Bold");
    scale: 1.1 1.1 1.1;
    transition-duration: 0.3s;
}

.button:active {
    width: 100%;
    height: 30%;
    padding-top: 30px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    color: rgb(145, 145, 145);
    font-size: 680%;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/CinzelDecorative-Bold.ttf?fileID=12800000&guid=2d6b41b3ee63e4d45985cca10623275f&type=3#CinzelDecorative-Bold");
    transition-duration: 0.2s;
    scale: 0.9 0.9 9;
}
