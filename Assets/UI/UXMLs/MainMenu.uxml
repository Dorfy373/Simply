<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/MainMenu.uss?fileID=7433441132597879392&amp;guid=7d9265ebd103f6e4d9b284bf08417e3d&amp;type=3#MainMenu"/>
    <ui:VisualElement name="MainMenuRoot" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="Background" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/UI/Icons/Enter_Background.jpg?fileID=2800000&amp;guid=9be52ada32c0b0a4c99c8369de5ad34c&amp;type=3#Enter_Background&quot;);">
            <ui:VisualElement name="MenuContainer" style="flex-grow: 0; flex-shrink: 0; align-items: center; justify-content: center; align-self: center; align-content: stretch; width: 50%; height: 75%; bottom: auto; top: 12%;">
                <ui:VisualElement name="GameTitle" style="flex-grow: 0; height: 35%; width: 75%; background-image: url(&quot;project://database/Assets/UI/Icons/GameName.png?fileID=2800000&amp;guid=2ecf37cbf2f87ea4ea934a49258caf62&amp;type=3#GameName&quot;); margin-top: 0; margin-right: 0; margin-bottom: 70px; margin-left: 0;"/>
                <ui:VisualElement name="ButtonsContainer" style="flex-grow: 1; width: 75%; height: auto;">
                    <ui:Button text="Start" name="StartButton" class="button"/>
                    <ui:Button text="Settings" name="SettingsButton" class="button"/>
                    <ui:Button text="Quit" name="QuitButton" class="button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="v0.1" name="VersionLabel" style="position: absolute; -unity-text-align: lower-left; align-content: flex-end; align-self: flex-start; justify-content: space-evenly; align-items: center; bottom: 0%; color: rgb(255, 255, 255); font-size: 50%; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/CinzelDecorative-Regular.ttf?fileID=12800000&amp;guid=10e478dfad5c6aa45a7ce7ddf41cf017&amp;type=3#CinzelDecorative-Regular&quot;); right: auto; left: 1%;"/>
    </ui:VisualElement>
</ui:UXML>
