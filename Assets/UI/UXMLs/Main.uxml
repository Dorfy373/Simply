            <ui:Button text="main menu" name="MainMenuButton" class="buttonSettings" style="font-size: 40%;"/>
        </ui:VisualElement>
        <ui:VisualElement name="SettingsPanel" style="flex-grow: 0; position: relative; bottom: auto; height: 50%; width: 50%; flex-shrink: 1; align-items: center; justify-content: center; display: none;">
            <ui:Label text="Settings" name="SettingsTitle" style="width: 50%; font-size: 60%; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/CinzelDecorative-Black.ttf?fileID=12800000&amp;guid=5a20ff53e06edc745987ba94ed004e55&amp;type=3#CinzelDecorative-Black&quot;); -unity-text-align: middle-center; top: -30%;"/>
            <ui:Label text="Music volume" name="MusicLabel" style="font-size: 40%; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/CinzelDecorative-Regular.ttf?fileID=12800000&amp;guid=10e478dfad5c6aa45a7ce7ddf41cf017&amp;type=3#CinzelDecorative-Regular&quot;);"/>
            <ui:Slider label="" value="42" high-value="1" name="MusicVolumeSlider" style="width: 50%;"/>
            <ui:Button text="" name="SettingsBackButton" style="position: absolute; top: 5%; left: 3%; width: 10%; height: 15%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); background-image: url(&quot;project://database/Assets/UI/Icons/Exit_Icon.png?fileID=2800000&amp;guid=465c0bf6d780ef94a89eeea009714162&amp;type=3#Exit_Icon&quot;);"/>
