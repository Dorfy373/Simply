    <ui:VisualElement name="PauseOverlay" style="flex-grow: 1; position: absolute; top: 0; left: 0; bottom: 0; right: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.59); display: none;">
        <ui:VisualElement name="PausePanel" style="flex-grow: 0; bottom: auto; width: 50%; position: relative; height: 50%; padding-top: 30px; padding-right: 30px; padding-bottom: 30px; padding-left: 30px; align-items: center; justify-content: center; display: none; flex-shrink: 0;">
            <ui:Label text="Pause" name="PauseTitle" style="font-size: 60%; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/CinzelDecorative-Black.ttf?fileID=12800000&amp;guid=5a20ff53e06edc745987ba94ed004e55&amp;type=3#CinzelDecorative-Black&quot;); color: rgb(255, 255, 255); white-space: nowrap; -unity-text-align: upper-center; margin-top: 25px; margin-right: 25px; margin-bottom: 25px; margin-left: 25px; top: -10%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            <ui:Button text="Resume" name="ResumeButton" class="buttonSettings" style="font-size: 40%; white-space: nowrap;"/>
